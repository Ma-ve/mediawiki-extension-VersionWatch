{
	"name": "VersionWatch",
	"version": "1.0.0",
	"author": [
		"Mave"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:VersionWatch",
	"descriptionmsg": "versionwatch-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\VersionWatch\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\VersionWatch\\Tests\\": "tests/phpunit/"
	},
	"MessagesDirs": {
		"VersionWatch": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"VersionWatchAlias": "VersionWatch.alias.php"
	},
	"ServiceWiringFiles": [
		"src/ServiceWiring.php"
	],
	"SpecialPages": {
		"VersionWatch": {
			"class": "MediaWiki\\Extension\\VersionWatch\\Specials\\SpecialVersionWatch",
			"services": [
				"VersionWatch.VersionChecker",
				"VersionWatch.ReportStore",
				"VersionWatch.InstalledComponents",
				"VersionWatch.RepositorySettings"
			]
		}
	},
	"AvailableRights": [
		"versionwatch"
	],
	"GroupPermissions": {
		"sysop": {
			"versionwatch": true
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "VersionWatch/modules"
	},
	"ResourceModules": {
		"ext.versionWatch.styles": {
			"styles": [
				"ext.versionWatch.less"
			]
		}
	},
	"config": {
		"VersionWatchGitHubToken": {
			"description": "Optional GitHub token. Unauthenticated requests are limited to 60 per hour per IP address, which shared hosting may already use up.",
			"value": null
		},
		"VersionWatchIgnoredAuthors": {
			"description": "Commit authors whose commits do not count towards an extension being outdated, such as the bot that syncs translations every day.",
			"value": [
				"Translation updater bot"
			]
		}
	},
	"manifest_version": 2
}
